NeedItem = {
	{ 6909,	"냥다래열매" },
	{ 25464, "World_Tour_Ticket" }
}

local defaultEndableMapStruct = { mapName = "", needLevel = -1, needClearQuest = {}, needHaveItem = {} }

function main()
	for k, v in pairs(StartableMap) do
		result, msg = InsertStartableMap(v)
		if not result then
			return false, msg
		end
	end
	for key, v in pairs(EndableMap) do
		local strKey = tostring(key)
		local mapStruct = defaultEndableMapStruct
		if type(v) == "table" then
			print(strKey)
			mapStruct = v
			mapStruct.mapName = strKey
		else
			mapStruct = defaultEndableMapStruct
			mapStruct.mapName = v
		end
		result, msg = InsertEndableMap(mapStruct.mapName, mapStruct)
		if not result then
			return false, msg
		end
	end
	for k, v in pairs(NeedItem) do
		result, msg = InsertNeedItem(v[1], v[2])
		if not result then
			return false, msg
		end
	end
	return true, "success"
end
