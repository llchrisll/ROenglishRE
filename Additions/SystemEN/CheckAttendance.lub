Config = {
	StartDate = 20260805,
	EndDate = 20260901
}
Reward = {
	{ 1, 107614, 1},
	{ 2, 107616, 1 },
	{ 3, 107617, 2 },
	{ 4, 107618, 1 },
	{ 5, 107619, 1 },
	{ 6, 107620, 1 },
	{ 7, 107621, 1 },
	{ 8, 107622, 1 },
	{ 9, 107623, 1 },
	{ 10, 107624, 1 },
	{ 11, 107625, 1 },
	{ 12, 107626, 2 },
	{ 13, 107627, 1 },
	{ 14, 107628, 1 },
	{ 15, 107629, 1 },
	{ 16, 107630, 1 },
	{ 17, 107631, 1 },
	{ 18, 107632, 1 },
	{ 19, 107633, 1 },
	{ 20, 107634, 1 }
}
function main()
	result, msg = InsertCheckAttendanceConfig(Config.EvendOnOff, Config.StartDate, Config.EndDate)
	if not result then
		return false, msg
	end
	for k, rewardtbl in pairs(Reward) do
		result, msg = InsertCheckAttendanceReward(rewardtbl[1], rewardtbl[2], rewardtbl[3])
		if not result then
			return false, msg
		end
	end
	return true, "success"
end
